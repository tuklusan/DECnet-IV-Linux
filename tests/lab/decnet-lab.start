#!/bin/sh
set -eu

. /etc/decnet-lab.env
exec >/dev/ttyS0 2>&1

echo "DNIV-LAB node=${NODE_NAME} address=${NODE_ADDR} start"
ip link set "${IFACE}" up
modprobe decnet_iv
dnctl set "${NODE_ADDR}" "${NODE_NAME}"
dnctl reset-stats

# Give both guests time to finish booting before exchanging raw Routing Layer frames.
sleep 8
i=1
while [ "$i" -le 8 ]; do
    dnraw "${IFACE}" "${PEER_MAC}" "${NODE_NAME}-probe-${i}"
    i=$((i + 1))
    sleep 1
done

sleep 4
dnctl stats
echo "DNIV-LAB-DONE ${NODE_NAME}"
sync
poweroff -f
