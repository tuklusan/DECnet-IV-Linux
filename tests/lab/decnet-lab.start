#!/bin/sh
set -eu

. /etc/decnet-lab.env
if [ -c /dev/ttyS0 ]; then
    serial_console=/dev/ttyS0
elif [ -c /dev/ttyAMA0 ]; then
    serial_console=/dev/ttyAMA0
else
    serial_console=/dev/console
fi
exec >"$serial_console" 2>&1

find_iface_by_mac() {
    target=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')
    for address_file in /sys/class/net/*/address; do
        [ -r "$address_file" ] || continue
        if [ "$(cat "$address_file")" = "$target" ]; then
            basename "$(dirname "$address_file")"
            return 0
        fi
    done
    return 1
}

test -f /var/lib/decnet-lab/provisioned
test -f /usr/src/decnet_iv-0.1.0/AKMBUILD
find /etc/kernel-hooks.d -maxdepth 1 -name '*akms*.hook' -print -quit | grep -q .

module_path=$(modinfo -n decnet_iv)
case "$module_path" in
    */kernel/extra/akms/decnet_iv.ko*) ;;
    *)
        echo "DNIV-LAB unexpected module path: $module_path" >&2
        exit 1
        ;;
esac

iface=$(find_iface_by_mac "$LAN_MAC")
echo "DNIV-LAB session=${LAB_SESSION_ID} node=${NODE_NAME} address=${NODE_ADDR} iface=${iface} module=${module_path} start"
akms status || true

ip link set "$iface" up
modprobe decnet_iv
dnctl set "$NODE_ADDR" "$NODE_NAME"
dnctl reset-stats

# Mixed-architecture peers can complete provisioning at very different times.
# Keep sending probes until at least one peer frame is received, then stay alive
# long enough to return several probes so the peer can satisfy the same test.
i=1
received=0
while [ "$i" -le 900 ]; do
    dnraw "$iface" "$PEER_MAC" "${LAB_SESSION_ID}-${NODE_NAME}-probe-${i}"
    stats=$(dnctl stats)
    if printf '%s\n' "$stats" | grep -Eq 'Routing frames received = [1-9][0-9]*'; then
        received=1
        printf '%s\n' "$stats"
        break
    fi
    if [ $((i % 30)) -eq 0 ]; then
        echo "DNIV-LAB session=${LAB_SESSION_ID} node=${NODE_NAME} waiting-for-peer probes=${i}"
    fi
    i=$((i + 1))
    sleep 2
done

if [ "$received" -ne 1 ]; then
    echo "DNIV-LAB session=${LAB_SESSION_ID} node=${NODE_NAME} peer timeout" >&2
    dnctl stats >&2 || true
    exit 1
fi

j=1
while [ "$j" -le 8 ]; do
    dnraw "$iface" "$PEER_MAC" "${LAB_SESSION_ID}-${NODE_NAME}-confirm-${j}"
    j=$((j + 1))
    sleep 1
done

dnctl stats
echo "DNIV-LAB-DONE session=${LAB_SESSION_ID} node=${NODE_NAME}"
sync
poweroff -f
