[Unit]
Description=DECnet-IV-Linux PP-12 exact source release lifecycle smoke
After=systemd-udev-settle.service
ConditionKernelCommandLine=dniv.pp12=1

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/dniv-pp12-smoke
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
