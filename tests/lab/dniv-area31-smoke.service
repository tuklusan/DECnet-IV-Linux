[Unit]
Description=DECnet Phase IV Area-31 native candidate proof
After=systemd-udev-settle.service

[Service]
Type=oneshot
ExecCondition=/usr/bin/grep -Fqw dniv.area31=1 /proc/cmdline
ExecStart=/usr/local/sbin/dniv-area31-smoke
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
