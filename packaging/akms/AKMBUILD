modname=decnet_iv
modver=0.1.0
built_modules='kernel/decnet/decnet_iv.ko'

build() {
    mkdir -p "$builddir/kernel/decnet"
    touch "$builddir/kernel/decnet/Makefile"
    make ${MAKEFLAGS:-} -C "$kernel_srcdir" \
        M="$builddir/kernel/decnet" \
        src="$srcdir/kernel/decnet" \
        modules
}
