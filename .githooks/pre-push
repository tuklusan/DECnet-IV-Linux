#!/bin/sh
set -eu
repo_root="$(git rev-parse --show-toplevel)"
while IFS=' ' read -r local_ref local_oid remote_ref remote_oid; do
    [ -n "$local_oid" ] || continue
    if [ "$local_oid" = "0000000000000000000000000000000000000000" ]; then
        continue
    fi
    base="$remote_oid"
    if [ "$base" = "0000000000000000000000000000000000000000" ]; then
        # The first push establishes the existing tree as the baseline.
        continue
    fi
    if [ -n "$base" ]; then
        powershell -NoProfile -ExecutionPolicy Bypass -File "$repo_root/scripts/push-gate.ps1" -Base "$base" -CommandLine "$remote_ref $local_ref"
    else
        powershell -NoProfile -ExecutionPolicy Bypass -File "$repo_root/scripts/push-gate.ps1" -All -CommandLine "$remote_ref $local_ref"
    fi
done
